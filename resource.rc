// Windows resource file — embeds icon, version info, AND all SDK binaries.
// The SDK files are embedded as RCDATA; SdkExtractor.hpp extracts them to
// %TEMP%\vedantu_svs\ at runtime so no sdk/ folder is needed alongside the exe.
#include <windows.h>

// ── App icon (shown in Explorer, taskbar, title bar) ────────────────────────
IDI_APPLICATION ICON "vedantu.ico"

// ── Version information ──────────────────────────────────────────────────────
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vedantu Innovations Pvt. Ltd.\0"
            VALUE "FileDescription",  "Vedantu Clicker System\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "VedantuClickerSystem\0"
            VALUE "LegalCopyright",   "Copyright 2025 Vedantu\0"
            VALUE "OriginalFilename", "VedantuClickerSystem.exe\0"
            VALUE "ProductName",      "Vedantu Clicker System\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ── Embedded SDK binaries (RCDATA) ──────────────────────────────────────────
// Hardcoded integers so the RC compiler doesn't accidentally treat them as strings
201 RCDATA "sdk_embed/QTWSCmdApp.exe"
202 RCDATA "sdk_embed/QTZT_SDK_V4.dll"
203 RCDATA "sdk_embed/Qt5Core.dll"
204 RCDATA "sdk_embed/Qt5Network.dll"
205 RCDATA "sdk_embed/Qt5WebSockets.dll"
206 RCDATA "sdk_embed/hidapi.dll"
207 RCDATA "sdk_embed/libcurl.dll"
208 RCDATA "sdk_embed/log4cplusU.dll"
209 RCDATA "sdk_embed/quazip1-qt5.dll"
210 RCDATA "sdk_embed/zlib.dll"
211 RCDATA "sdk_embed/SDK_V4_resources.rcc"
212 RCDATA "sdk_embed/config.ini"
213 RCDATA "sdk_embed/log.properties"
214 RCDATA "sdk_embed/MSVCP140.dll"
215 RCDATA "sdk_embed/VCRUNTIME140.dll"
216 RCDATA "sdk_embed/MSVCP140_1.dll"
217 RCDATA "sdk_embed/MSVCP140_2.dll"
218 RCDATA "sdk_embed/vccorlib140.dll"
219 RCDATA "sdk_embed/concrt140.dll"
220 RCDATA "sdk_embed/msvcp140_atomic_wait.dll"
221 RCDATA "sdk_embed/msvcp140_codecvt_ids.dll"
