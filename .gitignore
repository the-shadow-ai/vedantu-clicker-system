# =============================================================================
#  Vedantu Clicker System — .gitignore
# =============================================================================

# ── Build outputs ─────────────────────────────────────────────────────────────
build/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.ninja
.ninja_deps
.ninja_log

# ── MSVC / Visual Studio ──────────────────────────────────────────────────────
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vs/
*.user
*.suo
*.aps
*.pdb
*.ilk
*.exp
*.lib
*.pch
*.idb
ipch/

# ── Compiled binaries ─────────────────────────────────────────────────────────
*.exe
*.dll
*.obj
*.o

# ── Release artefacts (generated by post-build step) ─────────────────────────
AppRelease/

# ── Secrets — NEVER commit ────────────────────────────────────────────────────
.env

# ── ImGui saved layout (generated at runtime) ─────────────────────────────────
imgui.ini

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
*.csv

# ── vcpkg ─────────────────────────────────────────────────────────────────────
# vcpkg_installed/ is generated during build. Do NOT commit it.
vcpkg_installed/
# The sdk_embed/ binaries ARE committed (they are the pre-staged SDK files
# read by resource.rc at build time). Do not gitignore them.

# ── Node / ui-dashboard ───────────────────────────────────────────────────────
ui-dashboard/node_modules/
ui-dashboard/dist/
ui-dashboard/.env
ui-dashboard/.env.local

# ── OS artefacts ──────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db

# ── Editor configs ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
