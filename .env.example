# =============================================
# Vedantu Clicker System — Environment Config
#
# SETUP: Copy this file to .env, then fill in
#        the values for your environment.
#
#   cp .env.example .env
#
# WARNING: Never commit .env to version control.
# =============================================

# ── API — Click Event POST ────────────────────────────────────────────────────
# Base URL of the Vedantu OTM node that receives click events.
API_BASE_URL=https://otmnode.vedantu.com

# Endpoint path for posting click statistics.
API_POST_ENDPOINT=/hybrid/print-clicker-stats

# Retry policy for failed API calls.
API_MAX_RETRIES=10
API_RETRY_BASE_MS=100

# ── Session Validation API (GET) ──────────────────────────────────────────────
# Base URL of the Vedantu scheduling service.
SESSION_BASE_URL=https://scheduling.vedantu.com

# Endpoint path for fetching session info.
SESSION_ENDPOINT=/scheduling/onetofew/session/fetchForOrg

# HMAC secret used in session validation requests.
# CHANGE THIS to your actual secret — never use the placeholder in production.
SESSION_SECRET=CHANGE_ME

# ── SunVote SDK / WebSocket Bridge ───────────────────────────────────────────
# Path to QTWSCmdApp.exe.
# In production this is overridden at runtime by SdkExtractor after extraction
# to %TEMP%\vedantu_svs\. You only need to change this for local SDK testing.
WSCMDAPP_PATH=./sdk/QTWSCmdApp.exe

# WebSocket server config (QTWSCmdApp listens on this host:port).
WS_HOST=127.0.0.1
WS_PORT=9002

# ── Security — HMAC request signing (optional) ───────────────────────────────
# Set HMAC_ENABLED=true to sign every API POST with HMAC-SHA256.
# If enabled, set VOTING_HMAC_SECRET as an environment variable or store it
# in Windows Credential Manager under target name: VotingSystem/HmacSecret
HMAC_ENABLED=false

# ── TLS Certificate Pinning (optional) ───────────────────────────────────────
TLS_CERT_PINNING=false
TLS_PINNED_CERT_HASH=

# ── Offline Queue Storage ─────────────────────────────────────────────────────
# AES-256-GCM encrypted queue file used when the API is unreachable.
OFFLINE_QUEUE_PATH=%APPDATA%/VedantuClickerSystem/offline_queue.dat

# AES-256 key for offline queue encryption (64 hex chars = 32 bytes).
# CHANGE THIS to a randomly generated key before deployment.
OFFLINE_AES_KEY=CHANGE_ME_TO_64_HEX_CHARS

# ── React UI Dashboard WebSocket ──────────────────────────────────────────────
# Port the C++ backend exposes for the ui-dashboard to connect to.
UI_WS_PORT=9099

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
